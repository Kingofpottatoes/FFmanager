
{
    "manifest_version": 2,

    "name": "FFManager",
    "version": "1.0.0",
    "description": "Firefox theme manager for Caelestia",

    "browser_specific_settings": {
        "gecko": {
            "id": "ffmanager@king"
        }
    },

    "permissions": [
        "nativeMessaging",
        "tabs"
    ],

    "background": {
        "scripts": ["background.js"],
        "persistent": true
    }
}
