
{
    "manifest_version": 2,

    "name": "FFManager",
    "version": "1.0.1",
    "description": "Firefox theme manager",

    "browser_specific_settings": {
        "gecko": {
            "id": "ffmanager@king",
            "data_collection_permissions":{ "required": ["none"]}
        }
    },

    "permissions": [
        "nativeMessaging",
        "tabs"
    ],

    "background": {
        "scripts": ["native.js","background.js"],
        "persistent": true
    },
    "browser_action": {
        "default_title": "FFManager : Unnamed",
        "default_popup": "popup/popup.html",
        "default_area" :"navbar",
        "default_icon": "icons/Unnamed.svg"
    }
}
