
{
    "manifest_version": 2,

    "name": "FFManager",
    "version": "1.0.0",
    "description": "Firefox theme manager",

    "browser_specific_settings": {
        "gecko": {
            "id": "ffmanager@king"
        }
    },

    "permissions": [
        "nativeMessaging",
        "tabs"
    ],

    "background": {
        "scripts": ["native.js","background.js"],
        "persistent": true
    },
    "browser_action": {
        "default_title": "FFManager",
        "default_popup": "popup/popup.html"
    }
}
